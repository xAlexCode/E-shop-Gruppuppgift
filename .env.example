# Kopiera till .env och fyll i värdena från Supabase. .env committas aldrig.

# Supabase → Connect → Session pooler (byt [YOUR-PASSWORD] mot databaslösenordet)
DATABASE_URL=

# Supabase → Project Settings → Data API / API Keys (publishable-nyckeln får synas i webbläsaren)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Testkontot från Authentication → Users (skapat med Auto Confirm User)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
